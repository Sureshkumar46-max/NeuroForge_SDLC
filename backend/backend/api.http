###############################################################
################## SDLC WORKFLOW TEST - part 4 ###############
#################### PROJECT MANAGEMENT ########################
###############################################################

###############################################################
### 18. CREATE PROJECT
###############################################################

POST http://localhost:8080/api/projects
Authorization: Bearer {{projectManagerToken}}
Content-Type: application/json

{
  "name": "Inventory Management System",
  "description": "Inventory Management Project",
  "methodology": "AGILE",
  "techStackTags": "Java,Spring Boot,React,PostgreSQL",
  "startDate": "2026-07-21",
  "endDate": "2026-12-31",
  "status": "ACTIVE"
}

###

###############################################################
### SAVE PROJECT ID FROM RESPONSE
###############################################################

@projectId = 15

###

###############################################################
### 19. GET ALL PROJECTS
###############################################################

GET http://localhost:8080/api/projects
Authorization: Bearer {{projectManagerToken}}

###

###############################################################
### 20. GET PROJECT BY ID
###############################################################

GET http://localhost:8080/api/projects/15
Authorization: Bearer {{projectManagerToken}}

###

###############################################################
### 21. UPDATE PROJECT
###############################################################

PUT http://localhost:8080/api/projects/15
Authorization: Bearer {{projectManagerToken}}
Content-Type: application/json

{
  "name": "Inventory Management System Updated",
  "description": "Updated Inventory Project",
  "methodology": "AGILE",
  "techStackTags": "Java,Spring Boot,React,PostgreSQL,Docker",
  "startDate": "2026-07-21",
  "endDate": "2026-12-31",
  "status": "ACTIVE"
}

###

###############################################################
### 22. ASSIGN TEAM TO PROJECT
###############################################################

PUT http://localhost:8080/api/projects/15/team/21
Authorization: Bearer {{projectManagerToken}}

###

###############################################################
### 23. GET PROJECTS AGAIN
###############################################################

GET http://localhost:8080/api/projects
Authorization: Bearer {{projectManagerToken}}

###

###############################################################
### 24. DELETE PROJECT (RUN LAST ONLY)
###############################################################

DELETE http://localhost:8080/api/projects/{{projectId}}
Authorization: Bearer {{projectManagerToken}}

###

###############################################################
###################### EXPECTED RESULT #########################
###############################################################

# Create Project      -> 200
# Get All Projects    -> 200
# Get Project By ID   -> 200
# Update Project      -> 200
# Assign Team         -> 200
# Get Projects Again  -> 200
# Delete Project      -> 200 (Run only after completing all remaining modules)


