Authorization: Bearer {{superAdminToken}}

###

###############################################################
### 8. UPDATE ORGANIZATION
###############################################################

PUT http://localhost:8080/api/orgs/50
Authorization: Bearer {{superAdminToken}}
Content-Type: application/json

{
  "name": "Cloud Tech Organization Updated"
}

###

###############################################################
### 9. CREATE TEAM
###############################################################

